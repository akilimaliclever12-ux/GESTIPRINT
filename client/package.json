{
  "name": "gestiprint-client",
  "version": "1.0.0",
  "description": "Frontend React - GestiPrint, gestion d'imprimerie (Supabase, offline-first)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "tauri": "tauri",
    "pc:dev": "tauri dev",
    "pc:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/supabase-js": "^2.45.0",
    "@vitejs/plugin-react": "^5.2.0",
    "exceljs": "^4.4.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
